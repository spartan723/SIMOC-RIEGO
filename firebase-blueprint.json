{
  "entities": {
    "Device": {
      "title": "Device",
      "description": "Represents an edge Android monitoring station with a unique hardware ID.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique device identifier."
        },
        "name": {
          "type": "string",
          "description": "Human-friendly device name."
        },
        "hardwareModel": {
          "type": "string",
          "description": "Manufacturer and hardware model."
        },
        "batteryLevel": {
          "type": "number",
          "description": "Current battery percentage (0-100)."
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether device is currently active."
        },
        "lastSeen": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of last heartbeat from device."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        }
      },
      "required": ["id", "name", "hardwareModel", "isActive", "createdAt"]
    },
    "PumpProfile": {
      "title": "PumpProfile",
      "description": "Hydraulic agricultural pump configuration and vibration baseline.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique pump identifier."
        },
        "deviceId": {
          "type": "string",
          "description": "Unique device ID assigned to monitor this pump."
        },
        "name": {
          "type": "string",
          "description": "Pump name or tag."
        },
        "sector": {
          "type": "string",
          "description": "Agricultural sector or field zone."
        },
        "baselineRms": {
          "type": "number",
          "description": "Baseline healthy RMS vibration in m/s^2."
        },
        "yellowMultiplier": {
          "type": "number",
          "description": "Warning threshold multiplier over baseline."
        },
        "redMultiplier": {
          "type": "number",
          "description": "Critical threshold multiplier over baseline."
        },
        "alertPhoneNumber": {
          "type": "string",
          "description": "Contact number for automated SMS alert dispatch."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": ["id", "deviceId", "name", "sector", "baselineRms", "yellowMultiplier", "redMultiplier", "createdAt"]
    },
    "VibrationReading": {
      "title": "VibrationReading",
      "description": "Telemetry reading captured from physical accelerometer and spectral FFT analysis.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique reading identifier."
        },
        "pumpId": {
          "type": "string",
          "description": "ID of monitored pump."
        },
        "deviceId": {
          "type": "string",
          "description": "ID of device that captured telemetry."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of measurement."
        },
        "rms": {
          "type": "number",
          "description": "Root Mean Square acceleration magnitude in m/s^2."
        },
        "peakFrequency": {
          "type": "number",
          "description": "Dominant harmonic frequency in Hz from FFT."
        },
        "peakToPeak": {
          "type": "number",
          "description": "Peak-to-peak vibration excursion in m/s^2."
        },
        "status": {
          "type": "string",
          "enum": ["OPTIMAL", "WARNING", "CRITICAL"],
          "description": "Mechanical evaluation status."
        },
        "healthPercentage": {
          "type": "number",
          "description": "Computed mechanical health score (0-100%)."
        }
      },
      "required": ["id", "pumpId", "deviceId", "timestamp", "rms", "peakFrequency", "peakToPeak", "status", "healthPercentage"]
    },
    "MaintenanceLog": {
      "title": "MaintenanceLog",
      "description": "Service and repair record for a pump.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique log identifier."
        },
        "pumpId": {
          "type": "string",
          "description": "ID of pump serviced."
        },
        "deviceId": {
          "type": "string",
          "description": "ID of device assigned to pump."
        },
        "date": {
          "type": "string",
          "format": "date-time",
          "description": "Date of maintenance event."
        },
        "description": {
          "type": "string",
          "description": "Work performed or parts replaced."
        },
        "costUsd": {
          "type": "number",
          "description": "Cost in USD."
        },
        "technician": {
          "type": "string",
          "description": "Name or identifier of technician."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of record creation."
        }
      },
      "required": ["id", "pumpId", "deviceId", "date", "description", "costUsd", "technician", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}/devices/{deviceId}": {
      "schema": {
        "$ref": "#/entities/Device"
      },
      "description": "Registered edge monitoring Android devices owned by user."
    },
    "/users/{userId}/pumps/{pumpId}": {
      "schema": {
        "$ref": "#/entities/PumpProfile"
      },
      "description": "Pump profiles owned by user and monitored by a unique device."
    },
    "/users/{userId}/readings/{readingId}": {
      "schema": {
        "$ref": "#/entities/VibrationReading"
      },
      "description": "Continuous vibration readings and alerts scoped to user."
    },
    "/users/{userId}/maintenance/{maintenanceId}": {
      "schema": {
        "$ref": "#/entities/MaintenanceLog"
      },
      "description": "Maintenance history records for user's pumps."
    }
  }
}
